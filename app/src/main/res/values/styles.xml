<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="StationTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">#8B0000</item>
        <item name="colorPrimaryDark">#200000</item>
        <item name="colorAccent">#BD4747</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C0C0C0</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
    <style name="StationDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#BD4747</item>
        <item name="android:background">#1E1E1E</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
